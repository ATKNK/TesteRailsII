<div class="flex flex-col justify-baseline">
    <p class="text-3xl">Bem vindo, <%= current_user.name %></p>

    <div class="mt-5 flex flex-row">
            <div class="bg-blue-950 border-amber-300 p-4 rounded-lg border-4 flex flex-col justify-center items-center w-full max-w-md">
                <p class="text-2xl">Questionários Aleatórios:</p>
                <div class="grid grid-cols-2 gap-4">
                    <% @questionnaires.each do |questionnaire| %>
                        <div id="<%= dom_id questionnaire %>" 
                            class="flex flex-col justify-between w-full p-6 border border-amber-300 rounded-lg bg-slate-800 text-white">
        
                        <div>
                            <p><strong>Code:</strong> <%= questionnaire.code %></p>
                            <p><strong>Title:</strong> <%= questionnaire.title %></p>
                        </div>
        
                        </div>
                    <% end %>
                </div>
            </div>
    </div>
</div>