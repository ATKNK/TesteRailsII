<div id="<%= dom_id questionnaire %>" class="flex flex-col justify-around w-[40vh] p-[5%] border-2 border-amber-300 rounded-lg bg-slate-800">

  <div>
      <div>
        <strong>Código:</strong>
        <%= questionnaire.code %>
      </div>
    
      <div>
        <strong>Título:</strong>
        <%= questionnaire.title %>
      </div>
    
      <div>
        <strong>Descrição:</strong>
        <%= questionnaire.description %>
      </div>
    
      <div>
        <strong>Duração:</strong>
        <%= questionnaire.duration_minutes %>
        <span>minutos</span>
      </div>
  </div>

  <p class="text-amber-300">
    <%= link_to "Mostrar esse questionário", questionnaire %>
  </p>

</div>
