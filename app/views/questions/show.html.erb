<div class="bg-blue-950 border-amber-300 p-6 rounded-lg border-4 flex flex-col w-full max-w-4xl mx-auto">

  <% if notice.present? %>
    <p class="text-green-400 mb-4"><%= notice %></p>
  <% end %>

  <!-- Header -->
  <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center mb-6">
    <h1 class="text-3xl text-white font-bold mb-2 sm:mb-0"><%= @question.enunciation %></h1>

    <%= link_to "Back to questions", questions_path,
          class: "bg-sky-800 hover:bg-sky-700 border-amber-300 border-2 text-white font-bold p-[1vh] flex justify-center items-center rounded-[3vh]" %>
  </div>

  <!-- Questionnaire info -->
  <div class="mb-6">
    <p class="text-white"><strong>Questionnaire:</strong> <%= @question.questionnaire&.title %></p>
  </div>

  <!-- Options Section -->
  <div class="mb-6">
    <h2 class="text-2xl text-white font-semibold mb-3">Options</h2>
    
    <ul class="list-disc list-inside space-y-2 p-[5%] text-white border-2 border-amber-300 rounded-lg bg-slate-800">
      <% @question.question_options.each do |option| %>
        <li class="flex justify-between items-center">
          <span><%= option.title %></span>
          <% if option.is_correct %>
            <span class="text-green-400 font-semibold">(Correct)</span>
          <% end %>
        </li>
      <% end %>
    </ul>

  </div>

  <!-- Actions -->
  <div class="flex flex-row gap-4 pt-4">
    <%= link_to "Add Options", new_question_option_path(question_id: @question.id),
          class: "bg-green-600 hover:bg-green-500 border-amber-300 border-2 text-white font-bold p-[1vh] flex justify-center items-center rounded-[3vh]" %>

    <%= link_to "Edit this question", edit_question_path(@question),
          class: "bg-sky-800 hover:bg-sky-700 border-amber-300 border-2 text-white font-bold p-[1vh] flex justify-center items-center rounded-[3vh]" %>

    <%= button_to "Destroy this question", @question, method: :delete,
          class: "bg-red-800 hover:bg-red-700 border-amber-300 border-2 text-white font-bold p-[1vh] flex justify-center items-center rounded-[3vh]" %>
  </div>

</div>
