<navbar class="flex flex-row justify-between items-center box-border w-full h-[10vh] bg-blue-950 text-amber-300">
  <a class="px-[3%] text-xl font-bold" href="/home">Code Quiz</a>
  <a class="px-[3%]" href="/questionnaires">Questionários</a>
  <div class=px-[3%]>
    <% if user_signed_in? %>
      <span> <%= current_user.name %></span>
      <%= button_to "Sair", destroy_user_session_path, method: :delete %>
    <% else %>
        <a href="users/sign_in">Entrar</a>
        <a href="users/sign_up">Registrar</a>
    <% end %>
  </div>
</navbar>
